PORT=4000
CLIENT_URL=http://localhost:5173
# Neon PostgreSQL Connection String (Lấy từ Dashboard Neon: Dashboard -> Project -> Connection Details)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require

# Cloudinary Credentials (Lấy từ Cloudinary Dashboard: Settings / Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Authentication
ADMIN_USERNAME=admin
# Mật khẩu mặc định là 'admin123' hoặc chạy lệnh 'npm run hash-password <mật_khẩu_mới>'
ADMIN_PASSWORD_HASH=$2a$10$wT0l8k23qIq71qf2m1p0fOeqdZkSg6s0W8e4j4vH3gC6d8jO3nK7q
JWT_SECRET=document_storage_system_secret_key_2026_super_secure
